def calcular_frete(distancia, tipo_cliente):
    # R$ 0,50 por km rodado
    valor = distancia * 0.50
    
    # Taxa adicional se a distância for maior que 100km
    if distancia > 100:
        valor += 15.00
        
    # Desconto para VIP
    if tipo_cliente.upper() == "VIP":
        valor *= 0.80  # 20% de desconto
        
    return valor

# Programa Principal
distancia_input = float(input("Digite a distância em km: "))
tipo_input = input("Digite o tipo de cliente (Padrão/VIP): ")

frete_final = calcular_frete(distancia_input, tipo_input)
print(f"O valor final do frete é: R$ {frete_final:.2f}")
